{
  "name": "LeeysPremium",
  "short_name": "LeeysPremium",
  "description": "Shop home, tech, fashion, beauty, outdoors, pets and more. Fast US shipping, worldwide delivery.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#04060d",
  "theme_color": "#04060d",
  "categories": ["shopping", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Shop all products", "url": "/collections/all?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Track my order", "url": "/track?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My cart", "url": "/cart?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
